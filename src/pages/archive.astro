---
import SiteLayout from "../layouts/SiteLayout.astro";
import { formatDate, getPosts } from "../lib/posts";
import styles from "./Archive.module.css";

const posts = await getPosts();
---

<SiteLayout
  title="Archive"
  description="Browse all articles by Agustín Díaz on web development, frontend engineering, CSS, JavaScript, and design."
>
  <article class="Page">
    <h1 class="Page__Title">Archive</h1>
    <ul class={styles.Archive} itemscope itemtype="https://schema.org/ItemList">
      {posts.map((post, index) => (
        <li
          class="Archive__Item"
          itemprop="itemListElement"
          itemscope
          itemtype="https://schema.org/ListItem"
        >
          <a class="lead Archive__Item__Link" href={`/${post.id}/`} itemprop="url">
            <span itemprop="name">{post.data.title}</span>
          </a>{" "}
          <time class={styles.Archive__Item__Date} datetime={post.data.pubDate.toISOString()}>
            {formatDate(post.data.pubDate)}
          </time>
          <meta itemprop="position" content={String(index + 1)} />
        </li>
      ))}
    </ul>
  </article>
</SiteLayout>
