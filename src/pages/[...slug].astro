---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BlogPost from "../components/BlogPost.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getLegacyPages, type LegacyPage } from "../lib/pages";

interface Props {
  page?: LegacyPage;
  post?: CollectionEntry<"blog">;
}

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const pages = getLegacyPages();

  return [
    ...posts.map((post) => ({ params: { slug: post.id }, props: { post } })),
    ...pages.map((page) => ({
      params: { slug: page.slug || undefined },
      props: { page },
    })),
  ];
}

const { page: legacyPage, post } = Astro.props;

let page: LegacyPage;
if (legacyPage) {
  page = legacyPage;
} else {
  if (!post) {
    throw new Error("A page or blog post is required to render this route.");
  }

  const homePage = getLegacyPages().find((page) => page.slug === "");
  if (!homePage) {
    throw new Error("The home page is required to build blog posts.");
  }

  page = {
    ...homePage,
    slug: post.id,
    title: post.data.title,
    description: post.data.description,
    canonical: `https://adiaz.uy/${post.id}/`,
    content: "",
    isArticle: true,
    publishedAt: post.data.pubDate.toISOString(),
    previous: post.data.previous,
    next: post.data.next,
    structuredData: JSON.stringify({
      description: post.data.description,
      url: `https://adiaz.uy/${post.id}/`,
      image: {
        height: "300px",
        width: "300px",
        url: "https://adiaz.uy/public/Logo.png",
        "@type": "ImageObject",
      },
      author: { "@type": "Person", name: "Agustín Díaz" },
      "@type": "BlogPosting",
      headline: post.data.title,
      dateModified: post.data.pubDate.toISOString(),
      datePublished: post.data.pubDate.toISOString(),
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": `https://adiaz.uy/${post.id}/`,
      },
      "@context": "https://schema.org",
    }),
  };
}

const Content = post ? (await render(post)).Content : undefined;
---

<SiteLayout page={page}>
  {post && Content ? (
    <BlogPost post={post}>
      <Content />
    </BlogPost>
  ) : (
    <Fragment set:html={page.content} />
  )}
</SiteLayout>
