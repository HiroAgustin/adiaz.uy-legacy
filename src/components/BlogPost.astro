---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "../lib/posts";
import { siteMetadata } from "../lib/site";
import styles from "./BlogPost.module.css";

interface Props {
  post: CollectionEntry<"blog">;
  linkedTitle?: boolean;
}

const { post, linkedTitle = false } = Astro.props;
const href = `/${post.id}/`;

if (!Astro.site) {
  throw new Error("Configure the site URL before building the site.");
}

const canonical = new URL(href, Astro.site);
const avatar = new URL(siteMetadata.avatar.path, Astro.site);
const image = post.data.image && new URL(post.data.image.path, Astro.site);
const authorUrl = new URL("/about/", Astro.site);
---

<article class={styles.Post} itemscope itemtype="https://schema.org/BlogPosting">
  <header>
    <h1 class={styles.Post__Title} itemprop="headline">
      {linkedTitle ? <a href={href}>{post.data.title}</a> : post.data.title}
    </h1>
    <time
      class={styles.Post__Date}
      itemprop="datePublished"
      datetime={post.data.pubDate.toISOString()}
    >
      {formatDate(post.data.pubDate)}
    </time>
    {post.data.updatedDate && (
      <meta itemprop="dateModified" content={post.data.updatedDate.toISOString()} />
    )}
    <meta itemprop="mainEntityOfPage" content={canonical} />
    <span itemprop="publisher" itemscope itemtype="https://schema.org/Organization">
      <span itemprop="logo" itemscope itemtype="https://schema.org/ImageObject">
        <meta itemprop="url" content={avatar} />
        <meta itemprop="width" content={`${siteMetadata.avatar.width} px`} />
        <meta itemprop="height" content={`${siteMetadata.avatar.height} px`} />
      </span>
      <meta itemprop="name" content={siteMetadata.title} />
      <meta itemprop="url" content={Astro.site} />
    </span>
    <span itemprop="author" itemscope itemtype="https://schema.org/Person">
      <span itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
        <meta itemprop="url" content={avatar} />
        <meta itemprop="width" content={`${siteMetadata.avatar.width} px`} />
        <meta itemprop="height" content={`${siteMetadata.avatar.height} px`} />
      </span>
      <meta itemprop="name" content={siteMetadata.author.name} />
      <meta itemprop="url" content={authorUrl} />
    </span>
    {post.data.image && (
      <span itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
        <meta itemprop="url" content={image} />
        <meta itemprop="width" content={`${post.data.image.width} px`} />
        <meta itemprop="height" content={`${post.data.image.height} px`} />
      </span>
    )}
  </header>
  <section itemprop="articleBody">
    <slot />
  </section>
</article>
