---

<footer class="Footer">
  <div class:list={["Container", styles.Footer__Content]}>
    <ul class={styles.SocialNav}>
      {links.map(({ name, href, path }) => (
        <li class="SocialNav__Item">
          <a
            class:list={[styles.SocialNav__Link, styles[`SocialNav__Link--${name}`]]}
            href={href}
            rel="noopener noreferrer"
            target="_blank"
            title={name}
          >
            <svg
              role="img"
              aria-label={`${name} icon`}
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
            >
              <path d={path} />
            </svg>
          </a>
        </li>
      ))}
    </ul>
    <p>
      <small>
        All code and content for this site is{" "}
        <a href="https://github.com/HiroAgustin/adiaz.github.com/">available on GitHub</a>
      </small>
    </p>
  </div>
</footer>
