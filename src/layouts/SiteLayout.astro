---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles.css";

interface Props {
  title?: string;
  description?: string;
  type?: "Blog" | "WebSite" | "WebPage" | "BlogPosting";
  publishedAt?: Date;
  previous?: string;
  next?: string;
}

const {
  title = "adiaz.uy",
  description = "Agustín Díaz (@HiroAgustin) · Web Development Blog.",
  type = "WebPage",
  publishedAt,
  previous,
  next,
} = Astro.props;

if (!Astro.site) {
  throw new Error("Configure the site URL before building the site.");
}

const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL("/public/Logo.png", Astro.site);
const structuredData = {
  "@context": "https://schema.org",
  "@type": type,
  name: "adiaz.uy",
  headline: title,
  description,
  url: canonical.href,
  image: {
    "@type": "ImageObject",
    url: image.href,
    height: 300,
    width: 300,
  },
  author: { "@type": "Person", name: "Agustín Díaz" },
  ...((type === "Blog" || type === "WebSite") && {
    sameAs: [
      "https://twitter.com/HiroAgustin/",
      "https://github.com/HiroAgustin/",
      "https://codepen.io/HiroAgustin/",
      "https://linkedin.com/in/HiroAgustin/en/",
    ],
  }),
  ...(publishedAt && {
    datePublished: publishedAt.toISOString(),
    dateModified: publishedAt.toISOString(),
    mainEntityOfPage: { "@type": "WebPage", "@id": canonical.href },
  }),
};
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="light dark" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content="H3h1-fkuHBo-jtqa_TZWrWFlc8DFdeTWSw1bqyYFFUs" />
    <title>{title === "adiaz.uy" ? title : `${title} · adiaz.uy`}</title>
    <meta name="author" content="Agustín Díaz" />
    <meta property="og:locale" content="en_US" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="adiaz.uy" />
    <meta property="og:image" content={image} />
    <meta property="og:image:height" content="300" />
    <meta property="og:image:width" content="300" />
    <meta property="og:type" content={type === "BlogPosting" ? "article" : "website"} />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:image" content={image} />
    <meta property="twitter:title" content={title} />
    <meta name="twitter:site" content="@HiroAgustin" />
    <meta name="twitter:creator" content="@HiroAgustin" />
    {previous && <link rel="prev" href={previous} />}
    {next && <link rel="next" href={next} />}
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")}
    />
    <link
      rel="icon"
      type="image/x-icon"
      href="data:image/x-icon;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQEAYAAABPYyMiAAAABmJLR0T///////8JWPfcAAAACXBIWXMAAABIAAAASABGyWs+AAAAF0lEQVRIx2NgGAWjYBSMglEwCkbBSAcACBAAAeaR9cIAAAAASUVORK5CYII="
    />
    <link rel="alternate" type="application/atom+xml" title="adiaz.uy" href="/atom.xml" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#202020" />
  </head>
  <body>
    <Header />
    <main>
      <div class="Container">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
